<Window x:Class="Ac8SaveEditor.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam account id" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Name="LblHelp" TextWrapping="Wrap" Margin="0,0,0,10">The save is encrypted with the Steam account id (the number in Steam\userdata\&lt;id&gt;). Type that number.</TextBlock>
        <TextBox Name="TxtId" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="BtnOk" Click="Ok_Click" Style="{StaticResource Primary}" Margin="0,0,8,0" IsDefault="True">OK</Button>
            <Button Name="BtnCancel" IsCancel="True">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
