<Window x:Class="Ac8SaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AC8 Save Editor" Icon="app.ico" Height="860" Width="1400" MinWidth="1000" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel>
                <TextBlock Text="ACE COMBAT 8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Save Editor" FontSize="16" VerticalAlignment="Center" Margin="8,0,20,0" Foreground="{StaticResource Fg2}"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ComboBox Name="CmbLang" Width="110" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ComboBoxItem>English</ComboBoxItem>
                        <ComboBoxItem>Português</ComboBoxItem>
                    </ComboBox>
                    <Button Name="BtnBrowse" Click="Browse_Click" Margin="0,0,8,0">Save folder...</Button>
                    <Button Name="BtnReload" Click="Reload_Click" Margin="0,0,8,0">Recarregar</Button>
                    <Button Name="BtnSave" Click="Save_Click" Style="{StaticResource Primary}" IsEnabled="False">Salvar (com backup)</Button>
                </StackPanel>
                <TextBlock Name="LblFile" VerticalAlignment="Center" Foreground="{StaticResource Fg2}"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,5">
            <TextBlock Name="LblStatus" Foreground="{StaticResource Fg2}"/>
        </Border>
        <Border DockPanel.Dock="Left" Width="210" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <ListBox Name="Nav" SelectionChanged="Nav_SelectionChanged" ItemContainerStyle="{StaticResource NavItem}">
                <ListBoxItem Tag="overview">Visão geral</ListBoxItem>
                <ListBoxItem Tag="missions">Missões</ListBoxItem>
                <ListBoxItem Tag="aircraft">Aviões</ListBoxItem>
                <ListBoxItem Tag="skins">Skins</ListBoxItem>
                <ListBoxItem Tag="emblems">Emblemas</ListBoxItem>
                <ListBoxItem Tag="medals">Medalhas</ListBoxItem>
                <ListBoxItem Tag="parts">Peças</ListBoxItem>
                <ListBoxItem Tag="assault">Registros de ases</ListBoxItem>
                <ListBoxItem Tag="features">Recursos e flags</ListBoxItem>
                <ListBoxItem Tag="system">Opções (System.sav)</ListBoxItem>
                <ListBoxItem Tag="raw">Avançado (árvore)</ListBoxItem>
            </ListBox>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="14,10,6,10">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Name="LblPageTitle" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Name="LblSearch" Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Fg2}"/>
                        <TextBox Name="TxtSearch" Width="220" TextChanged="Search_TextChanged"/>
                        <ComboBox Name="CmbFilter" Width="150" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
                        <Button Name="BtnAll" Click="UnlockAll_Click" Margin="8,0,0,0">Marcar todos</Button>
                        <Button Name="BtnNone" Click="LockAll_Click" Margin="6,0,0,0">Desmarcar todos</Button>
                    </StackPanel>
                    <TextBlock Name="LblPageInfo" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Fg2}"/>
                </DockPanel>
                <ContentControl Name="PageHost"/>
            </DockPanel>
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="Detail">
                        <TextBlock Text="Selecione um item para ver detalhes." Foreground="{StaticResource Fg2}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
